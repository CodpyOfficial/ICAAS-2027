# Settings for deploy/icas.service. Copy to /etc/icas/icas.env and make it
# readable by root only, since it holds the admin password:
#   sudo install -D -m 600 deploy/icas.env.example /etc/icas/icas.env
# Restart the service after editing: sudo systemctl restart icas

# Listen on loopback only and let a reverse proxy (nginx, Caddy) serve
# HTTPS on ports 80 and 443. To serve plain HTTP directly instead, set
# ICAS_ADDR=:8090 and remove ICAS_TRUST_PROXY.
ICAS_ADDR=127.0.0.1:8090
ICAS_TRUST_PROXY=1

# Public origin for canonical links and sitemap.xml.
ICAS_BASE_URL=https://icaas.example.org

# Uncomment to turn on /admin. Use a long random password, for example
# the output of: openssl rand -base64 24
#ICAS_ADMIN_USER=admin
#ICAS_ADMIN_PASSWORD=
