# Settings for deploy/icaas.service. Copy to /etc/icaas/icaas.env and make it
# readable by root only, since it holds the admin password:
#   sudo install -D -m 600 deploy/icaas.env.example /etc/icaas/icaas.env
# Restart the service after editing: sudo systemctl restart icaas

# Listen on loopback only and let a reverse proxy (nginx, Caddy) serve
# HTTPS on ports 80 and 443. To serve plain HTTP directly instead, set
# ICAAS_ADDR=:8090 and remove ICAAS_TRUST_PROXY.
ICAAS_ADDR=127.0.0.1:8090
ICAAS_TRUST_PROXY=1

# Public origin for canonical links and sitemap.xml.
ICAAS_BASE_URL=https://icaas.example.org

# Uncomment to turn on /admin. Use a long random password, for example
# the output of: openssl rand -base64 24
#ICAAS_ADMIN_USER=admin
#ICAAS_ADMIN_PASSWORD=
